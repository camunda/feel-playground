{
  "name": "@camunda/feel-playground",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/lib/core.js"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run build:lib && vite build",
    "build:lib": "npm run typecheck && vite build --config vite.lib.config.ts",
    "prepare": "npm run build:lib",
    "test": "vitest run --config vite.test.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "dependencies": {
    "@bpmn-io/cm-theme": "^0.2.2",
    "@bpmn-io/feel-editor": "^2.7.1",
    "@camunda/design-system": "^0.51.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
