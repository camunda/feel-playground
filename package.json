{
  "name": "@camunda/feel-playground",
  "version": "1.0.0-alpha.1",
  "description": "Playground for editing and evaluating FEEL expressions",
  "license": "MIT",
  "author": "Camunda Services GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camunda/feel-playground.git"
  },
  "keywords": [
    "camunda",
    "feel",
    "dmn",
    "expression",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "all": "npm run lint && npm test && npm run build && npm run test:distro",
    "start": "vite",
    "build": "npm run typecheck && vite build --config vite.lib.config.ts",
    "prepare": "npm run build",
    "lint": "eslint .",
    "test": "vitest run --config vite.test.config.ts",
    "test:distro": "node --test test/distro/distro.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@camunda/design-system": "^0.51.0",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "dependencies": {
    "@bpmn-io/cm-theme": "^0.2.2",
    "@bpmn-io/feel-analyzer": "^0.5.0",
    "@bpmn-io/feel-editor": "^2.7.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@camunda/design-system": "^0.51.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.2.0",
    "es-module-lexer": "^2.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-bpmn-io": "^2.3.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
